        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"${bucket}\", tag: \"cruce\", predicate: (r) => r._measurement == \"paso_seguro_estado\", start: -30d)",
        "definition": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"${bucket}\", tag: \"cruce\", predicate: (r) => r._measurement == \"paso_seguro_estado\", start: -30d)",
        "refresh": 1,
