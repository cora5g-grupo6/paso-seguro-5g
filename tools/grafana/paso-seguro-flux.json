          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"paso_seguro_estado\" and r.cruce == \"${cruce}\")\n  |> filter(fn: (r) => r._field == \"estado_num\")\n  |> group(columns: [\"_field\"])\n  |> sort(columns: [\"_time\"])\n  |> last()"
        }
