# Paso Seguro 5G · configuración del borde
# Copiar a .env y ajustar. El archivo .env NO se versiona: nunca poner claves reales en el repositorio.

# --- General ---------------------------------------------------------------
# URL con la que el teléfono del guía y los webhooks llegan al borde (para los enlaces de las alertas)
URL_PUBLICA=http://IP-DEL-BORDE:8000
# Habilita /api/demo/* (inyectar nivel, lluvia o persona). Poner false fuera de ensayos.
MODO_DEMO=true

# --- Umbrales (los del kit del grupo) -------------------------------------------
UMBRAL_CUIDADO=40
UMBRAL_CERRADO=70
HISTERESIS=10
# Segundos sostenidos para bajar un escalón. Demo: 30. En un río real: 900 o más.
BAJADA_S=30
# Subida rápida (%/min) que ya es CUIDADO
TASA_CUIDADO=15
LLUVIA_1H_MM=10
LLUVIA_3H_MM=25

# --- Cámara ------------------------------------------------------------------------
# Lista por orden de preferencia, separada por comas:
#   rtsp://USUARIO:CLAVE@IP-CAMARA:554/RUTA   cámara 5G Nokia (ruta por confirmar con la PCII)
#   0                                         webcam USB
#   http://IP-TELEFONO:8080/video             teléfono como cámara IP
#   ../tools/videos/rio_prueba.mp4            video de prueba (vale igual en la laptop y en Docker)
CAMARA_ACTIVA=true
CAMARA_FUENTES=../tools/videos/rio_prueba.mp4
# auto: usa PyAV para RTSP si OpenCV no trae FFmpeg (Mac). Opciones: auto | opencv | pyav
CAMARA_LECTOR=auto
CAMARA_FPS_ANALISIS=5
# Personas: hog (detector de peatones) | movimiento (cualquier cosa que entre a la zona) | apagado
PERSONAS_METODO=movimiento
# Zona del cruce en píxeles del cuadro analizado: x,y,ancho,alto (vacío = todo el cuadro)
PERSONAS_ZONA=0,160,290,320

# --- ESP32 por MQTT (además de HTTP) ------------------------------------------------
MQTT_ACTIVO=true
MQTT_HOST=localhost
MQTT_PUERTO=1883
MQTT_BASE=pasoseguro
MQTT_USUARIO=
MQTT_CLAVE=

# --- IMN (necesita internet; sin internet usa el último dato guardado) ---------------
IMN_ACTIVO=true
# Vacío = la estación más cercana al cruce
IMN_ESTACION=
IMN_INTERVALO_S=600

# --- Alertas -----------------------------------------------------------------------
# Webhooks genéricos, separados por comas (vacío = apagado).
# No pasan por el guardia de prueba: nunca poner aquí un flujo de producción ni de WhatsApp real.
WEBHOOK_URLS=
# n8n: SIEMPRE apagado salvo pruebas. Solo un flujo de PRUEBA aparte, con número de PRUEBA.
# La URL tiene que tener "prueba" o "test" en la ruta, si no el borde no envía.
N8N_ACTIVO=false
N8N_WEBHOOK_URL=
# PTT/PTV Nokia Team Comms: stub hasta conocer la API (deja la alerta en datos/ptt_pendientes.jsonl)
PTT_ACTIVO=false

# --- Comparación borde vs nube (necesita internet) ------------------------------------
NUBE_ACTIVA=true
NUBE_URL=https://www.google.com/generate_204

# --- InfluxDB (opcional: historia para gráficos o el gemelo digital) -------------------
# Apagado por defecto. Si el otro grupo o la PCII ya tienen una base, poner aquí sus datos.
INFLUX_ACTIVO=false
# p. ej. http://IP-DEL-SERVIDOR:8086 o la URL de InfluxDB Cloud
INFLUX_URL=
# 2 = InfluxDB 2.x, Cloud y 3.x (token, org y bucket) · 1 = InfluxDB 1.x (usuario y clave)
INFLUX_VERSION=2
INFLUX_ORG=
# En InfluxDB 1.x, el nombre de la base
INFLUX_BUCKET=paso_seguro
# El token va solo en .env: nunca en el repositorio ni en el chat del grupo
INFLUX_TOKEN=
INFLUX_USUARIO=
INFLUX_CLAVE=
# Cada cuántos segundos se manda el estado (además de cada cambio) y cada cuántos las latencias
INFLUX_INTERVALO_S=5
INFLUX_LATENCIA_INTERVALO_S=30

# --- Feed de Waze ----------------------------------------------------------------------
# endtime estimado por bloques de N horas mientras dura el cierre
WAZE_BLOQUE_H=3
# minutos que un incidente terminado sigue en el feed para que Waze lo lea
WAZE_RETENCION_MIN=60
